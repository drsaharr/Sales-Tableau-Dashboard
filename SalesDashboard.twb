          <datasource-dependencies datasource='federated.06zlb4102q9b10155zom01n9rtck'>
            <column caption='Sales' datatype='real' name='[Calculation_841047242621943809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Quantity]*[UnitPrice]' />
            </column>
            <column caption='Today' datatype='date' name='[Calculation_841047242624856067]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()' />
